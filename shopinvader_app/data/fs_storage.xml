<odoo noupdate="1">

    <!--
        TODO we should provide a simple way to serve image for testing purpose
        Implementing a public option on the fs_backend to serve the image ?:q
    -->

    <record id="fs_storage_shopinvader" model="fs.storage">
        <field name="name">Shopinvader Image File Storage</field>
        <field name="protocol">file</field>
        <field name="code">fsshop</field>
        <field name="directory_path">/data/odoo/filestore/db/storage/images</field>
        <field
            name="model_xmlids"
        >search_engine_image_thumbnail.model_se_thumbnail</field>
        <field name="use_filename_obfuscation" eval="False" />
        <field name="autovacuum_gc" eval="False" />
        <field name="base_url">http://cdn.localhost:9080</field>
        <field name="force_db_for_default_attachment_rules">{}</field>
        <field name="options">{"auto_mkdir": true}</field>
    </record>
</odoo>
