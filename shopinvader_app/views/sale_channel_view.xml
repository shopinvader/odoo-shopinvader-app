<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="sale_channel_view_form" model="ir.ui.view">
        <field name="model">sale.channel</field>
        <field
            name="inherit_id"
            ref="sale_channel_search_engine.sale_channel_view_form"
        />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    string="Configure Shopinvader Assistant"
                    type="action"
                    name="%(shopinvader_new_channel_wizard_action)d"
                    class="btn-primary"
                    attrs="{'invisible': [
                    '|',
                    ('channel_type', '!=', 'shopinvader'),
                    ('search_engine_id', '!=', False)
                    ]}"
                />
            </header>
            <group name="search-engine" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': [('channel_type', '!=', 'shopinvader')]}</attribute>
            </group>
            <group name="search-engine" position="after">
                <group
                    name="fastapi-endpoint"
                    string="API ENDPOINT"
                    attrs="{'invisible': [('channel_type', '!=', 'shopinvader')]}"
                >
                    <field name="fastapi_endpoint_id" />
                </group>
            </group>
        </field>
    </record>

</odoo>
